{
  "name": "shining-ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for @shining-technologies/ui: React components, a server-ready data table and CSS-variable theming.",
  "license": "MIT",
  "author": "Shining Technologies",
  "homepage": "https://github.com/Shining-Technologies/shining-ui-kit-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shining-Technologies/shining-ui-kit-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Shining-Technologies/shining-ui-kit-pro/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm --filter @shining-technologies/ui build",
    "dev": "pnpm --filter @shining-technologies/ui-gallery dev",
    "gallery": "pnpm --filter @shining-technologies/ui-gallery dev",
    "typecheck": "pnpm --filter @shining-technologies/ui typecheck && pnpm --filter @shining-technologies/ui-gallery typecheck",
    "test": "pnpm --filter @shining-technologies/ui test",
    "test:watch": "pnpm --filter @shining-technologies/ui test:watch",
    "test:recharts3": "pnpm --filter @shining-technologies/ui test:recharts3",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:recharts3 && pnpm check:docs",
    "check:docs": "node scripts/check-docs-links.mjs",
    "clean": "rimraf -g \"packages/*/dist\" \"apps/*/dist\" \"**/*.tsbuildinfo\" coverage",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version:packages": "changeset version && pnpm install --lockfile-only",
    "check:exports": "pnpm --filter @shining-technologies/ui exec attw --pack . --profile esm-only --exclude-entrypoints styles.css theme.css presets.css tailwind.css",
    "prepublish:check": "node scripts/check-publish.mjs && pnpm check:exports",
    "publish:dry": "pnpm build && pnpm prepublish:check && pnpm --filter @shining-technologies/ui exec npm pack --dry-run",
    "release": "pnpm build && pnpm prepublish:check && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.0.5"
    }
  }
}
