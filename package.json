{
  "name": "shining-ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "A React component library whose entire appearance comes from a swappable project palette.",
  "license": "MIT",
  "author": "Shining Technologies",
  "homepage": "https://github.com/Shining-Technologies/shining-ui-kit-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shining-Technologies/shining-ui-kit-pro.git"
  },
  "bugs": {
    "url": "https://github.com/Shining-Technologies/shining-ui-kit-pro/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm --filter @shining-technologies/ui-kit-gallery dev",
    "gallery": "pnpm --filter @shining-technologies/ui-kit-gallery dev",
    "tokens": "node scripts/update-tokens.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:recharts3": "vitest run --config vitest.recharts3.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:recharts3 && pnpm check:docs",
    "clean": "rimraf -g \"packages/*/dist\" \"apps/*/dist\" \"**/*.tsbuildinfo\" coverage storybook-static",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version:packages": "changeset version && pnpm install --lockfile-only",
    "check:exports": "pnpm -r --filter \"./packages/*\" exec attw --pack . --exclude-entrypoints styles.css",
    "prepublish:check": "node scripts/check-publish.mjs && pnpm check:exports",
    "publish:dry": "pnpm build && pnpm prepublish:check && pnpm -r --filter \"./packages/*\" exec npm pack --dry-run",
    "release": "pnpm build && pnpm prepublish:check && changeset publish",
    "check:docs": "node scripts/check-docs-links.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.17.0",
    "@microsoft/api-extractor": "^7.59.1",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-themes": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-storybook": "^0.11.1",
    "happy-dom": "^20.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "storybook": "^8.4.7",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.0.5"
    }
  }
}
