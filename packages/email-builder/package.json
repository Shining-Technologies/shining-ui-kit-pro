{
  "name": "@shining-technologies/email-builder",
  "version": "0.1.0",
  "description": "The email editor for shining-email: rich-text email designs with merge fields, brand-styled buttons and a server-rendered preview.",
  "keywords": [
    "react",
    "email",
    "email-editor",
    "tiptap",
    "merge-fields",
    "newsletter"
  ],
  "license": "MIT",
  "author": "Shining Technologies",
  "homepage": "https://github.com/Shining-Technologies/shining-ui-kit-pro/tree/master/packages/email-builder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shining-Technologies/shining-ui-kit-pro.git",
    "directory": "packages/email-builder"
  },
  "bugs": {
    "url": "https://github.com/Shining-Technologies/shining-ui-kit-pro/issues"
  },
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./design": {
      "types": "./dist/design.d.ts",
      "default": "./dist/design.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node scripts/build-css.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
