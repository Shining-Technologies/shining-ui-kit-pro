{
  "version": 1,
  "mode": "blocks",
  "settings": {
    "width": 640,
    "background": "#eef1f5",
    "content_background": "brand.content_background_color",
    "font": "georgia",
    "padding": [20, 16, 20, 16]
  },
  "rows": [
    {
      "id": "r_head",
      "padding": [24, 24, 8, 24],
      "background": "brand.background_color",
      "hide_on": null,
      "gap": 16,
      "columns": [
        {
          "id": "c_head",
          "width": 100,
          "hide_on": null,
          "valign": "top",
          "background": null,
          "padding": [0, 0, 0, 0],
          "blocks": [
            {
              "id": "b_heading",
              "type": "heading",
              "level": 1,
              "html": "Welcome, <strong>{{ contact.first_name|there }}</strong>",
              "align": "center",
              "color": "brand.primary_color",
              "style": {
                "padding": [8, 0, 8, 0],
                "background": "#ffffff",
                "color": "brand.text_color",
                "font": "brand.heading_font",
                "font_size": 28,
                "font_weight": "bold"
              }
            },
            {
              "id": "b_text",
              "type": "text",
              "html": "<p>Thanks for getting in touch. <strong>Here is what happens next.</strong></p><ul><li>One</li><li>Two</li></ul>",
              "align": "right",
              "style": {
                "padding": [8, 12, 8, 12],
                "background": "#f9fafb",
                "color": "#374151",
                "font": "verdana",
                "font_size": 16,
                "font_weight": "normal"
              }
            },
            {
              "id": "b_image",
              "type": "image",
              "src": "https://cdn.example.test/hero.png",
              "asset_id": "as_hero",
              "alt": "The team",
              "width": 320,
              "align": "center",
              "link": "https://example.test/team",
              "radius": 12,
              "style": {
                "padding": [8, 0, 8, 0],
                "background": "brand.content_background_color"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "r_split",
      "padding": [16, 24, 16, 24],
      "background": null,
      "hide_on": "mobile",
      "gap": 24,
      "columns": [
        {
          "id": "c_left",
          "width": 33,
          "hide_on": "desktop",
          "valign": "middle",
          "background": "#f3f4f6",
          "padding": [8, 8, 8, 8],
          "blocks": [
            {
              "id": "b_avatar",
              "type": "avatar",
              "src": "https://cdn.example.test/me.jpg",
