            }
          ]
        },
        {
          "id": "c_media_b",
          "width": 34,
          "hide_on": null,
          "valign": "top",
          "background": null,
          "padding": [0, 0, 0, 0],
          "blocks": [
            {
              "id": "b_social_custom",
