              "alt": "Sam from Acme",
              "size": 96,
              "shape": "rounded",
              "align": "center",
              "style": { "padding": [0, 0, 0, 0], "background": "#ffffff" }
            }
          ]
        },
        {
          "id": "c_right",
          "width": 67,
          "hide_on": null,
          "valign": "bottom",
          "background": null,
          "padding": [0, 0, 0, 0],
          "blocks": [
            {
              "id": "b_button",
              "type": "button",
              "label": "Book a time",
              "url": "https://example.test/book",
              "align": "left",
              "full_width": true,
              "style": {
                "padding": [8, 0, 8, 0],
                "background": "brand.primary_color",
                "color": "brand.button_text_color",
                "font": "tahoma",
                "font_size": 18,
                "font_weight": "bold",
                "radius": 40,
                "padding_y": 16,
                "padding_x": 32,
                "border_color": "#111827",
                "border_width": 2
