    },
    {
      "id": "r_foot",
      "padding": [16, 24, 16, 24],
      "background": null,
      "hide_on": null,
      "gap": 16,
      "columns": [
        {
          "id": "c_foot",
          "width": 100,
          "hide_on": null,
