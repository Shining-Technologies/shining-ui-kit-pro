{
  "name": "@shining-technologies/ui-kit-react",
  "version": "0.2.0",
  "description": "Shining UI Kit for React: buttons, cards, forms, charts and a production-grade data table, all painted from one swappable project palette.",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "design-tokens",
    "theming",
    "charts",
    "datatable",
    "data-grid",
    "tanstack",
    "shadcn",
    "radix",
    "typescript"
  ],
  "license": "MIT",
  "author": "Shining Technologies",
  "homepage": "https://github.com/Shining-Technologies/shining-ui-kit-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shining-Technologies/shining-ui-kit-pro.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/Shining-Technologies/shining-ui-kit-pro/issues"
  },
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./virtualized": {
      "import": {
        "types": "./dist/virtualized.d.ts",
        "default": "./dist/virtualized.js"
      },
      "require": {
        "types": "./dist/virtualized.d.cts",
        "default": "./dist/virtualized.cjs"
      }
    },
    "./recharts": {
      "import": {
        "types": "./dist/recharts.d.ts",
        "default": "./dist/recharts.js"
      },
      "require": {
        "types": "./dist/recharts.d.cts",
        "default": "./dist/recharts.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "virtualized": [
        "./dist/virtualized.d.ts"
      ],
      "recharts": [
        "./dist/recharts.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "vite build && pnpm build:css && pnpm build:cjs-types",
    "build:css": "node ../../scripts/build-css.mjs ./src/styles/index.css ./dist/styles.css",
    "build:cjs-types": "node ../../scripts/emit-cjs-types.mjs ./dist",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@shining-technologies/ui-kit-core": "workspace:*",
    "@tanstack/react-table": "^8.20.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.11.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "recharts": "^2.15.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.11.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "recharts-v3": "npm:recharts@^3.10.0",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
