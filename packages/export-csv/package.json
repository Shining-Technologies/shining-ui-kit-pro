{
  "name": "@shining-technologies/ui-kit-export-csv",
  "version": "0.1.1",
  "description": "Optional CSV/TSV export for the Shining UI Kit data table. Zero runtime dependencies.",
  "keywords": [
    "csv",
    "tsv",
    "export",
    "download",
    "data-table",
    "tanstack",
    "zero-dependency",
    "typescript"
  ],
  "license": "MIT",
  "author": "Shining Technologies",
  "homepage": "https://github.com/Shining-Technologies/shining-ui-kit-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shining-Technologies/shining-ui-kit-pro.git",
    "directory": "packages/export-csv"
  },
  "bugs": {
    "url": "https://github.com/Shining-Technologies/shining-ui-kit-pro/issues"
  },
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && pnpm build:cjs-types",
    "build:cjs-types": "node ../../scripts/emit-cjs-types.mjs ./dist",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "@tanstack/table-core": "^8.20.5"
  },
  "devDependencies": {
    "@tanstack/table-core": "^8.20.5",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
