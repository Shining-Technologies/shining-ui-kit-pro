{
  "name": "@shining-technologies/ui",
  "version": "2.1.1",
  "description": "Shining UI V2: React components, a framework-independent data-table core and shadcn-style CSS-variable theming in one Next.js-ready package.",
  "keywords": [
    "react",
    "nextjs",
    "server-components",
    "component-library",
    "design-system",
    "design-tokens",
    "css-variables",
    "shadcn",
    "radix",
    "datatable",
    "tanstack",
    "typescript"
  ],
  "license": "MIT",
  "author": "Shining Technologies",
  "homepage": "https://github.com/Shining-Technologies/shining-ui-kit-pro/tree/master/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shining-Technologies/shining-ui-kit-pro.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Shining-Technologies/shining-ui-kit-pro/issues"
  },
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "default": "./dist/charts/index.js"
    },
    "./virtualized": {
      "types": "./dist/components/data-table/virtualized.d.ts",
      "default": "./dist/components/data-table/virtualized.js"
    },
    "./csv": {
      "types": "./dist/csv/index.d.ts",
      "default": "./dist/csv/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./presets.css": "./dist/presets.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    }
  },
  "scripts": {
    "build": "vite build && node scripts/generate-presets.mjs && node scripts/build-css.mjs && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs && node scripts/check-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:recharts3": "vitest run --config vitest.recharts3.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-hover-card": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-menubar": "^1.1.4",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slider": "^1.2.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toggle": "^1.1.1",
    "@radix-ui/react-toggle-group": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.11.0",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "recharts": "^2.15.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-virtual": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.11.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "recharts-v3": "npm:recharts@^3.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
