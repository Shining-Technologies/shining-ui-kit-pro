{
  "name": "@shining-technologies/ui-kit-core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for Shining UI Kit: design tokens, the OKLCH colour engine, the project system, and the data-table engine.",
  "keywords": [
    "design-tokens",
    "design-system",
    "oklch",
    "color",
    "palette",
    "theming",
    "wcag",
    "contrast",
    "data-table",
    "tanstack",
    "typescript"
  ],
  "license": "MIT",
  "author": "Shining Technologies",
  "homepage": "https://github.com/Shining-Technologies/shining-ui-kit-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shining-Technologies/shining-ui-kit-pro.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Shining-Technologies/shining-ui-kit-pro/issues"
  },
  "engines": {
    "node": ">=18.18"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && pnpm build:cjs-types",
    "build:cjs-types": "node ../../scripts/emit-cjs-types.mjs ./dist",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/table-core": "^8.20.5"
  },
  "devDependencies": {
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
